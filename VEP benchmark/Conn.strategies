id : 8
priority : core(4)
left : ConnListrep(?p : Z) at 0
       (p != NULL || NULL != p) at 1
right : (store_char_array(field_addr(p, connection, key), ?m, ?l) || data_at(field_addr(p, connection, next), PTR(struct connection), ?q : Z)) at 2
action : left_erase(0);
         left_exist_add(l0 : list{Z});
         left_exist_add(y : Z);
         left_exist_add(n0 : Z);
         left_add(l0[n0] == 0);
         left_add(0 <= n0);
         left_add(n0 < 128);
         left_add(store_char_array(field_addr(p, connection, key), 128, l0));
         left_add(data_at(field_addr(p, connection, next), PTR(struct connection), y));
         left_add(ConnListrep(y));
 
id : 9
priority : core(4)
left : (?p : Z != NULL || NULL != ?p : Z) at 0
right : ConnListrep(p) at 1
